# Copy this file to .env.local and fill in the secret values.
# Never commit .env.local.

# PostgreSQL / Supabase database
PLANTALK_PGHOST=your-database-host
PLANTALK_PGPORT=5432
PLANTALK_PGDATABASE=postgres
PLANTALK_PGUSER=your-database-user
PLANTALK_PGPASSWORD=

# Backend administration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Supabase storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plantalk-images

# Gmail SMTP for ID lookup and password reset.
# MAIL_PASSWORD is the SMTP app password/credential issued for the sender account.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-account@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Public backend URL embedded in the mobile app build
EXPO_PUBLIC_API_URL=https://api.your-domain.com
